{
  "schema": "vps3xui/restore-source-record/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "backup_id",
    "backup_digest",
    "manifest_id",
    "manifest_digest",
    "source",
    "obtained"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "vps3xui.restore.source_record"
      ]
    },
    "backup_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "backup_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "manifest_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,64}$"
    },
    "manifest_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ssh_alias",
        "host_key_fingerprint",
        "machine_id"
      ],
      "properties": {
        "ssh_alias": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "host_key_fingerprint": {
          "type": "string",
          "pattern": "^SHA256:[A-Za-z0-9+/=]{8,128}$"
        },
        "machine_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        }
      }
    },
    "obtained": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "source_job_id",
        "observed_at"
      ],
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "source_job_request"
          ]
        },
        "source_job_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "observed_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        }
      }
    }
  }
}
