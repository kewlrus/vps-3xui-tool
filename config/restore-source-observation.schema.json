{
  "schema": "vps3xui/restore-source-observation/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "observed_at",
    "channel",
    "source",
    "probe_complete",
    "docker",
    "containers",
    "fencing"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "vps3xui.restore.source_observation"
      ]
    },
    "observed_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "channel": {
      "type": "string",
      "enum": [
        "ssh_pinned_host_key"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ssh_alias",
        "host_key_fingerprint",
        "machine_id"
      ],
      "properties": {
        "ssh_alias": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "host_key_fingerprint": {
          "type": "string",
          "pattern": "^SHA256:[A-Za-z0-9+/=]{8,128}$"
        },
        "machine_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        }
      }
    },
    "probe_complete": {
      "type": "boolean"
    },
    "docker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service",
        "socket"
      ],
      "properties": {
        "service": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "load_state",
            "active_state"
          ],
          "properties": {
            "load_state": {
              "type": "string",
              "maxLength": 32
            },
            "active_state": {
              "type": "string",
              "maxLength": 32
            }
          }
        },
        "socket": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "load_state",
            "active_state"
          ],
          "properties": {
            "load_state": {
              "type": "string",
              "maxLength": 32
            },
            "active_state": {
              "type": "string",
              "maxLength": 32
            }
          }
        }
      }
    },
    "containers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "present",
          "running",
          "restart_policy"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "present": {
            "type": "boolean"
          },
          "running": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "restart_policy": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 32
          }
        }
      }
    },
    "fencing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method"
      ],
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "docker_units_masked",
            "containers_restart_disabled"
          ]
        }
      }
    }
  }
}
