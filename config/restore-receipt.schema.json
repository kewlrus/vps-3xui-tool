{
  "schema": "vps3xui/restore-receipt/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "job_id",
    "stage",
    "plan_identity",
    "backup_digest",
    "target",
    "steps",
    "observed",
    "verified",
    "created_at",
    "receipt_digest"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "prepared_target",
        "verified_payload",
        "data_restored",
        "containers_created",
        "guard_prepared",
        "activation",
        "verification_report",
        "certbot_activated"
      ]
    },
    "job_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "stage": {
      "type": "string",
      "enum": [
        "prepare",
        "stage",
        "activate",
        "verify",
        "certbot_activate"
      ]
    },
    "plan_identity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "backup_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host_key_fingerprint",
        "machine_id"
      ],
      "properties": {
        "host_key_fingerprint": {
          "type": "string",
          "pattern": "^SHA256:[A-Za-z0-9+/=]{8,128}$"
        },
        "machine_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        }
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][A-Za-z0-9._:-]{0,127}$"
      },
      "uniqueItems": true
    },
    "observed": {
      "type": "object"
    },
    "verified": {
      "type": "boolean",
      "enum": [
        true
      ]
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "receipt_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
